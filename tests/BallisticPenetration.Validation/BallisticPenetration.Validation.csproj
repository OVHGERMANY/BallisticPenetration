<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>BallisticPenetration.Validation</AssemblyName>
    <RootNamespace>BallisticPenetration.Validation</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep the validation runner independent of BepInEx and Tarkov assemblies. -->
    <Compile Include="..\..\src\BallisticPenetration\Core\**\*.cs" Link="Core\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
